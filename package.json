{
  "name": "timebase",
  "version": "1.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "update": "npm update web-features --save && node extract-data.js",
    "extract-logos": "node extract-logos.js",
    "start": "npx http-server ./ -p 8080 -c-1 --cors -o -a localhost -d false -i index.html",
    "stop": "kill $(lsof -t -i:8080) || echo 'No server running on port 8080'",
    "build": "npm run update && npm run extract-logos",
    "clear-cache": "echo 'Clearing browser cache...' && rm -rf ~/.cache/Cursor/Cache/*",
    "dev": "npm run build && npm run start"
  },
  "author": "",
  "license": "ISC",
  "description": "Timeline of web features and browser support",
  "dependencies": {
    "@browser-logos/chrome": "^2.0.0",
    "@browser-logos/edge": "^2.0.0",
    "@browser-logos/firefox": "^3.0.0",
    "@browser-logos/safari": "^2.0.0",
    "web-features": "^2.35.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
