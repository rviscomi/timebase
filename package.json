{
  "name": "timebase",
  "version": "1.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "update": "npm update web-futures --save && npm run update:meta",
    "update:meta": "node extract-data.js && node developer-signals.js && node interop.js && node mdn-docs.js",
    "extract-logos": "node extract-logos.js",
    "update-signals": "node developer-signals.js",
    "update-interop": "node interop.js",
    "update-mdn": "node mdn-docs.js",
    "start": "npx http-server ./dist -p 8080 -c-1 --cors -o -a localhost -d false -i dist/index.html",
    "stop": "kill $(lsof -t -i:8080) || echo 'No server running on port 8080'",
    "build": "node build.js",
    "clear-cache": "echo 'Clearing browser cache...' && rm -rf ~/.cache/Cursor/Cache/*",
    "dev": "npm run build && npm run start"
  },
  "author": "",
  "license": "ISC",
  "description": "Timeline of web features and browser support",
  "dependencies": {
    "@browser-logos/chrome": "^2.0.0",
    "@browser-logos/edge": "^2.0.0",
    "@browser-logos/firefox": "^3.0.0",
    "@browser-logos/safari": "^2.0.0",
    "web-futures": "^3.6.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
